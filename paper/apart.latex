$-- Pandoc LaTeX template in the style of an Apart preprint (NeurIPS-like).
$-- The .tex it produces goes to Overleaf as it is, with references.bib and figures/.
$-- Never set, so never printed: the line spec-check reads.
$if(spec-check-only)$
Implements: paper/built-two-ways, paper/forms-link-each-other, paper/teaser-moves-in-html
$endif$
\documentclass[10pt,letterpaper]{article}
\usepackage[letterpaper,textwidth=5.5in,textheight=9in,top=1in,headheight=12pt,headsep=25pt,footskip=30pt]{geometry}
\usepackage[T1]{fontenc}
$if(times)$
\usepackage{newtxtext,newtxmath}
$else$
\usepackage{lmodern}% the classic LaTeX look; times: true in the front matter for Times
$endif$
\usepackage{microtype}
\usepackage{xcolor}
\usepackage{amsmath}
\usepackage{graphicx}
\usepackage{booktabs,longtable,array,calc}
\usepackage[skins]{tcolorbox}
\usepackage[font=small,labelfont=bf,labelsep=colon,skip=4pt]{caption}
\usepackage{fancyhdr}
\usepackage[round]{natbib}
\renewcommand{\bibsection}{}
\bibliographystyle{plainnat}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}
\setcounter{secnumdepth}{2}

% NeurIPS-style headings
\makeatletter
\renewcommand{\section}{\@startsection{section}{1}{\z@}{-1.6ex \@plus -0.5ex \@minus -0.2ex}{1.0ex \@plus 0.3ex \@minus 0.2ex}{\large\bfseries\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}{-1.4ex \@plus -0.5ex \@minus -0.2ex}{0.5ex \@plus 0.2ex}{\normalsize\bfseries\raggedright}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}{-1.5ex \@plus -0.5ex \@minus -0.2ex}{0.5ex \@plus 0.2ex}{\normalsize\bfseries\raggedright}}
\makeatother

% What pandoc's output needs
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{%
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox{\pandoc@box}%
  \fi}
\def\fps@figure{htbp}% figures stay near where they're written
\makeatother
\def\LTcaptype{table}
$if(highlighting-macros)$
$highlighting-macros$
$endif$
$for(header-includes)$
$header-includes$
$endfor$

\definecolor{linkblue}{RGB}{0,51,160}% links read as links: a clear dark blue
\PassOptionsToPackage{hyphens}{url}% long URLs in the references break at hyphens
\usepackage[colorlinks=true,linkcolor=linkblue,citecolor=linkblue,urlcolor=linkblue]{hyperref}
\hypersetup{pdftitle={$title$}}

% No running header, only the page number; the sprint and the code link are
% said once, in the first page's footnote, under a rule the text's full width
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\small\thepage}
\renewcommand{\footnoterule}{\vspace*{-3pt}\noindent\rule{\textwidth}{0.4pt}\vspace{2.6pt}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\small\thepage}}

\begin{document}

\thispagestyle{plain}
\begin{center}
\rule{\textwidth}{4pt}\par\vspace{0.22in}
{\LARGE\bfseries $title$\par}
$if(subtitle)$\vspace{0.08in}{\large $subtitle$\par}$endif$
\vspace{0.2in}\rule{\textwidth}{1pt}\par\vspace{0.22in}
$for(author)$
\begin{tabular}[t]{c}\textbf{$author.name$}$if(author.affiliation)$\\ $author.affiliation$$endif$$if(author.email)$\\ \small\href{mailto:$author.email$}{\texttt{$author.email$}}$endif$\end{tabular}$sep$\hspace{1.5em}
$endfor$
\par
$if(date)$\vspace{0.12in}{$date$\par}$endif$
$if(web-url)$\vspace{0.08in}{\small This is the PDF version of this work. See the HTML version, with every game watchable, \href{$web-url$}{here}.\par}$endif$
\end{center}

{\makeatletter\long\def\@makefntext#1{\noindent#1}\makeatother\let\thefootnote\relax\footnotetext{\raggedright \href{$sprint-url$}{$sprint$}, Apart Research, $if(sprint-date)$$sprint-date$$else$$date$$endif$.\\Code and every game: \url{$repo$}}}

$if(abstract)$
\vspace{0.04in}
\noindent\rule{\textwidth}{0.4pt}\par\vspace{0.3ex}
\noindent{\large\bfseries Abstract}\par\vspace{0.4ex}
\noindent $abstract$\par
\vspace{0.2ex}\noindent\rule{\textwidth}{0.4pt}\par
$endif$

$if(teaser)$
\begin{center}
\includegraphics[width=$if(teaser-width)$$teaser-width$$else$0.85$endif$\linewidth]{$teaser$}
\captionof{figure}{$teaser-caption$$if(figure_lines.dig-debug-game)$\\{\footnotesize\raggedright Remake the figure or replay the game: $for(figure_lines.dig-debug-game)$$it$$sep$; $endfor$.}$endif$}$if(teaser-label)$\label{$teaser-label$}$endif$
\end{center}
$endif$

$if(toc)$
\vspace{0.06in}
{\setcounter{tocdepth}{1}\setlength{\parskip}{0pt}\tableofcontents}
$endif$


$body$

\end{document}
